<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Weather Dashboard</title>

    <meta name="description" content="Real-time weather dashboard using Fetch API and asynchronous JavaScript">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins',sans-serif;
        }

        body{
            background:linear-gradient(135deg,#0f172a,#1e293b);
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
            padding:20px;
            color:white;
        }

        .weather-container{
            width:100%;
            max-width:500px;
            background:rgba(255,255,255,0.08);
            backdrop-filter:blur(12px);
            border-radius:25px;
            padding:35px;
            box-shadow:0 10px 25px rgba(0,0,0,0.3);
        }

        .weather-container h1{
            text-align:center;
            margin-bottom:25px;
            color:#38bdf8;
        }

        .search-box{
            display:flex;
            gap:10px;
            margin-bottom:25px;
        }

        .search-box input{
            flex:1;
            padding:14px;
            border:none;
            border-radius:12px;
            outline:none;
            font-size:16px;
            background:#334155;
            color:white;
        }

        .search-box button{
            padding:14px 22px;
            border:none;
            border-radius:12px;
            background:#38bdf8;
            color:black;
            font-weight:600;
            cursor:pointer;
            transition:0.3s;
        }

        .search-box button:hover{
            background:#0ea5e9;
            color:white;
        }

        .weather-card{
            text-align:center;
            display:none;
        }

        .weather-card img{
            width:120px;
            margin:15px 0;
        }

        .temperature{
            font-size:55px;
            font-weight:700;
        }

        .city-name{
            font-size:30px;
            margin-bottom:10px;
        }

        .description{
            text-transform:capitalize;
            margin-bottom:25px;
            color:#cbd5e1;
        }

        .weather-details{
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:15px;
            margin-top:25px;
        }

        .detail-box{
            background:#1e293b;
            padding:18px;
            border-radius:15px;
        }

        .detail-box h3{
            font-size:16px;
            color:#38bdf8;
            margin-bottom:8px;
        }

        .error-message{
            text-align:center;
            color:#f87171;
            margin-top:15px;
            display:none;
        }

        .loading{
            text-align:center;
            display:none;
            margin-top:20px;
            color:#cbd5e1;
        }

        @media(max-width:500px){

            .weather-details{
                grid-template-columns:1fr;
            }

            .search-box{
                flex-direction:column;
            }

        }

    </style>

</head>

<body>

    <main class="weather-container" role="main">

        <h1>Weather Dashboard</h1>

        <section aria-label="Search Weather">

            <div class="search-box">

                <input
                    type="text"
                    id="cityInput"
                    placeholder="Enter city name"
                    aria-label="City Name"
                >

                <button id="searchBtn">
                    Search
                </button>

            </div>

        </section>

        <div class="loading" id="loading">
            Loading weather data...
        </div>

        <div class="error-message" id="errorMessage">
            City not found or network error occurred.
        </div>

        <section class="weather-card" id="weatherCard" aria-live="polite">

            <h2 class="city-name" id="cityName"></h2>

            <img id="weatherIcon" src="" alt="Weather Icon">

            <div class="temperature" id="temperature"></div>

            <p class="description" id="description"></p>

            <div class="weather-details">

                <article class="detail-box">

                    <h3>Humidity</h3>

                    <p id="humidity"></p>

                </article>

                <article class="detail-box">

                    <h3>Wind Speed</h3>

                    <p id="windSpeed"></p>

                </article>

                <article class="detail-box">

                    <h3>Feels Like</h3>

                    <p id="feelsLike"></p>

                </article>

                <article class="detail-box">

                    <h3>Pressure</h3>

                    <p id="pressure"></p>

                </article>

            </div>

        </section>

    </main>

    <script>

        const apiKey = "YOUR_API_KEY";

        const cityInput = document.getElementById("cityInput");

        const searchBtn = document.getElementById("searchBtn");

        const weatherCard = document.getElementById("weatherCard");

        const errorMessage = document.getElementById("errorMessage");

        const loading = document.getElementById("loading");

        async function fetchWeather(city){

            try{

                loading.style.display = "block";

                weatherCard.style.display = "none";

                errorMessage.style.display = "none";

                const response = await fetch(
                    `https://api.openweathermap.org/data/2.5/weather?q=${city}&appid=${apiKey}&units=metric`
                );

                if(!response.ok){

                    throw new Error("Failed to fetch weather");

                }

                const data = await response.json();

                renderWeather(data);

            }

            catch(error){

                errorMessage.style.display = "block";

            }

            finally{

                loading.style.display = "none";

            }

        }

        function renderWeather(data){

            const cityName = document.getElementById("cityName");

            const temperature = document.getElementById("temperature");

            const description = document.getElementById("description");

            const humidity = document.getElementById("humidity");

            const windSpeed = document.getElementById("windSpeed");

            const feelsLike = document.getElementById("feelsLike");

            const pressure = document.getElementById("pressure");

            const weatherIcon = document.getElementById("weatherIcon");

            cityName.textContent = data.name;

            temperature.textContent = `${Math.round(data.main.temp)}°C`;

            description.textContent = data.weather[0].description;

            humidity.textContent = `${data.main.humidity}%`;

            windSpeed.textContent = `${data.wind.speed} km/h`;

            feelsLike.textContent = `${Math.round(data.main.feels_like)}°C`;

            pressure.textContent = `${data.main.pressure} hPa`;

            const iconCode = data.weather[0].icon;

            weatherIcon.src = `https://openweathermap.org/img/wn/${iconCode}@2x.png`;

            weatherIcon.alt = data.weather[0].description;

            weatherCard.style.display = "block";

        }

        searchBtn.addEventListener("click", () => {

            const city = cityInput.value.trim();

            if(city !== ""){

                fetchWeather(city);

            }

        });

        cityInput.addEventListener("keypress", (event) => {

            if(event.key === "Enter"){

                searchBtn.click();

            }

        });

    </script>

</body>

</html>
